# MR AI MD — Railway Variables-e bosanor list
# Railway dashboard → Project → Service → Variables → prottek-ta add koro.
# Kono key/code ekhane likho NA — sudhu Railway-te bosao.

# Bot-er naam (na bosale "MR AI MD" hobe)
BOT_NAME=MR AI MD

# Owner-er naam
OWNER_NAME=MR AI

# Owner-er WhatsApp number — country code soho, + chara. Jemon: 8801956501630
OWNER_NUMBER=

# Bot-er chobi — image URL (https://...) ba bot-er folder-er vitore file
# (jemon: ./assets/bot.jpg). Menu ar .alive-e ei chobi asbe.
# Khali rakhle sudhu text-e menu asbe.
BOT_PHOTO=

# Command-er chinno (na bosale "." hobe)
PREFIX=.

# Je number diye bot pair hobe (secondary number use kora valo).
# Khali rakhle terminal-e QR code asbe, scan kore pair korte hobe.
PAIR_NUMBER=

# Groq AI key — .ai / .gpt / .llama / .mistral / .deepseek command-er jonno.
# console.groq.com theke free key neya jay.
GROQ_API_KEY=

# Gemini AI key — sudhu .gemini command-er jonno.
# aistudio.google.com theke free key neya jay.
GEMINI_API_KEY=
